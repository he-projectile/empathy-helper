# --- Окружение и пакетные менеджеры ---
.venv/
venv/
env/
.uv/

# --- Данные и Модели (храним только локально) ---
# Игнорируем папки с датасетами и результатами обучения
data/
datasets/
models/
weights/
runs/
logs/
checkpoints/
outputs/
.mlruns/

mlflow.db

# Игнорируем любые тяжелые форматы файлов ML
*.pth
*.pt
*.onnx
*.pkl
*.pickle
*.h5
*.ckpt
*.csv
*.jsonl

# --- Настройки VS Code и локальные секреты ---
.vscode/
*.code-workspace
# Локальные переменные окружения (пароли, API-ключи токенов)
.env
.env.local

# --- Кэш Python и системы ---
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
AGENTS.md

# Разрешаем Git заглянуть в саму папку data, но игнорируем всё её содержимое
!data/
data/*

# Делаем исключение ТОЛЬКО для технического файла .gitkeep
!data/.gitkeep
